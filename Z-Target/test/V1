using Raylib_cs;
using System.Numerics;

class Program
{
    public static void Main()
    {
        const int screenWidth = 1200;
        const int screenHeight = 800;
        Raylib.InitWindow(screenWidth, screenHeight, "Hello World");
        Raylib.SetTargetFPS(60);

        Vector2 ballPosition = new Vector2((float)screenWidth / 2, (float)screenHeight / 2);
        Vector2 size = new Vector2(50, 50);
        Vector2 direction = new Vector2(0, 0);
        float speed = 400.0f;
        
        
        float zombieSpeed = 200.0f;

        // create a list for the bullets
        List<Vector2> bullets = new List<Vector2>();
        // create a list for the bullet directions
        List<Vector2> bulletDirections = new List<Vector2>();
        float bulletSpeed = 1600.0f;

        //create a list for the zombies
        List<Vector2> zombies = new List<Vector2>();
        // create a list for the zombie directions
        List<Vector2> zombieDirections = new List<Vector2>();

        // create 5 zombies with random positions
        for (int i = 0; i < 5; i++)
        {
            Vector2 zombiePosition = new Vector2(Raylib.GetRandomValue(0, screenWidth), Raylib.GetRandomValue(0, screenHeight));
            zombies.Add(zombiePosition);
            Vector2 zombieDirection = new Vector2(Raylib.GetRandomValue(-1, 1), Raylib.GetRandomValue(-1, 1));
            zombieDirections.Add(zombieDirection);
        }


        while (!Raylib.WindowShouldClose())
        {
            float deltaTime = Raylib.GetFrameTime();
            if (Raylib.IsKeyDown(KeyboardKey.D)) direction.X = 1;
            else if (Raylib.IsKeyDown(KeyboardKey.A)) direction.X = -1;
            else direction.X = 0;
            if (Raylib.IsKeyDown(KeyboardKey.W)) direction.Y = -1;
            else if (Raylib.IsKeyDown(KeyboardKey.S)) direction.Y = 1;
            else direction.Y = 0;

            if (direction != Vector2.Zero)
            {
                direction = Vector2.Normalize(direction);
                ballPosition += direction * speed * deltaTime;
            }

            //get mouse position
            Vector2 mousePosition = Raylib.GetMousePosition();

            //rotate the rectangle towards the mouse position
            float angle = MathF.Atan2(mousePosition.Y - ballPosition.Y, mousePosition.X - ballPosition.X) * (180 / MathF.PI);
            

            // logic for the zombie to follow the player
            for (int i = 0; i < zombies.Count; i++)
            {
                Vector2 zombieDirection = Vector2.Normalize(ballPosition - zombies[i]);
                zombies[i] += zombieDirection * zombieSpeed * deltaTime;
                // draw the zombie
                Raylib.DrawCircle((int)zombies[i].X, (int)zombies[i].Y, 25, Color.Red);
            }

            // shoot a projectile towards the mouse position 
            if (Raylib.IsMouseButtonPressed(MouseButton.Left))
            {
                Vector2 bulletDirection = Vector2.Normalize(mousePosition - ballPosition);
                bullets.Add(ballPosition);
                bulletDirections.Add(bulletDirection);
            }
            // update the bullets
            for (int i = 0; i < bullets.Count; i++)
            {
                bullets[i] += bulletDirections[i] * bulletSpeed * deltaTime;
                // draw the bullet
                Raylib.DrawCircle((int)bullets[i].X, (int)bullets[i].Y, 5, Color.Black);
                // check if the bullet is out of bounds
                if (bullets[i].X < 0 || bullets[i].X > screenWidth || bullets[i].Y < 0 || bullets[i].Y > screenHeight)
                {
                    bullets.RemoveAt(i);
                    bulletDirections.RemoveAt(i);
                    i--;
                }
            }

            //when a zombie is hit by a bullet, remove the zombie and the bullet
            for (int i = 0; i < zombies.Count; i++)
            {
                for (int j = 0; j < bullets.Count; j++)
                {
                    if (Vector2.Distance(zombies[i], bullets[j]) < 25)
                    {
                        zombies.RemoveAt(i);
                        bulletDirections.RemoveAt(j);
                        bullets.RemoveAt(j);
                        i--;
                        break;
                    }
                }
            }

            //show remaining zombies
            Raylib.DrawText("zombies left : " + zombies.Count(), 10, 10, 20, Color.Black);
            //show score, for each zombie killed, add 10 to the score
            Raylib.DrawText("score : " + (50 - zombies.Count()*10), 10, 30, 20, Color.Black);

            

            Raylib.BeginDrawing();
            //rotate the rectangle
            Raylib.DrawRectanglePro(new Rectangle(ballPosition.X, ballPosition.Y, size.X, size.Y), new Vector2(size.X / 2, size.Y / 2), angle, Color.Maroon);

            //drawing the zombie

            Raylib.ClearBackground(Color.White);

            Raylib.EndDrawing();
        }

        Raylib.CloseWindow();
    }
}