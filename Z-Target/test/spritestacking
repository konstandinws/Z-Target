using Raylib_cs;
using System;
using System.Numerics;

class Program
{
    static void Main()
    {
        const int screenWidth = 800;
        const int screenHeight = 600;

        Raylib.InitWindow(screenWidth, screenHeight, "Max Ammo - Sprite Stack Rotating");
        Raylib.SetTargetFPS(60);

        const int sliceCount = 8;
        const int sliceOffset = 8; // Plus grand pour mieux voir les tranches
        const float scale = 10.0f;  // Facteur d’agrandissement
        const float rotationAmplitude = 360f; // Distance horizontale du "tour"
        const float rotationSpeed = 1f;
        Vector2 position = new Vector2(screenWidth / 2, screenHeight / 2);

        Texture2D[] slices = new Texture2D[sliceCount];
        for (int i = 0; i < sliceCount; i++)
        {
            slices[i] = Raylib.LoadTexture($"C:/Users/Konstantinos/Desktop/Zombie Raylib/Z-Target/car/img_{i}.png");
        }
        

        float angle = 0f;

        while (!Raylib.WindowShouldClose())
        {
            angle += rotationSpeed;

            Raylib.BeginDrawing();
            Raylib.ClearBackground(Color.DarkGray);

            int centerX = screenWidth / 2;
            int centerY = screenHeight / 2 + (sliceOffset * sliceCount / 2);

            for (int i = 0; i < sliceCount; i++)
            {
                int offsetY = i * - sliceOffset; 

                //int offsetY = i * sliceOffset; //marche mais change comment ca affiche
    
                Texture2D slice = slices[i];

                int drawX = centerX;
                
                int drawY = centerY + offsetY;

                Raylib.DrawTextureEx(slice, new System.Numerics.Vector2(drawX, drawY), angle, scale, Color.White);
                
            }

            Raylib.DrawText("Sprite Stack - Rotation + Scale", 20, 20, 20, Color.LightGray);
            Raylib.EndDrawing();
        }

        foreach (Texture2D slice in slices)
            Raylib.UnloadTexture(slice);

        Raylib.CloseWindow();
    }
}




