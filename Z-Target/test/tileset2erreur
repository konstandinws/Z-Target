using System;
using System.Collections.Generic;
using Raylib_cs;
using TiledCS;
using System.Numerics;

class Program
{
    static void Main()
    {
        // Initialisation Raylib
        const int screenWidth = 800;
        const int screenHeight = 600;
        Raylib.InitWindow(screenWidth, screenHeight, "Tiled + Raylib - Multi-Tileset");
        Raylib.SetTargetFPS(60);

        // Chemins des fichiers
        string mapPath = @"C:\Users\Konstantinos\Desktop\Zombie Raylib\Z-Target\map\map.tmx";
        string tileset1Path = @"C:\Users\Konstantinos\Desktop\Zombie Raylib\Z-Target\tilesets\TX Tileset Grass.tsx";
        string tileset1ImagePath = @"C:\Users\Konstantinos\Desktop\Zombie Raylib\Z-Target\tilesets\TX Tileset Grass.png";
        
        string tileset2Path = @"C:\Users\Konstantinos\Desktop\Zombie Raylib\Z-Target\tilesets\TX Tileset Wall.tsx";
        string tileset2ImagePath = @"C:\Users\Konstantinos\Desktop\Zombie Raylib\Z-Target\tilesets\TX Tileset Wall.png";

        // Chargement de la carte
        var map = new TiledMap(mapPath);
        
        // Chargement des tilesets
        var tilesets = new List<TiledTileset>
        {
            new TiledTileset(tileset1Path),
            new TiledTileset(tileset2Path)
        };

        // Chargement des textures
        var textures = new List<Texture2D>
        {
            Raylib.LoadTexture(tileset1ImagePath),
            Raylib.LoadTexture(tileset2ImagePath)
        };

        // Caméra
        Camera2D camera = new()
        {
            Target = new Vector2(0, 0),
            Offset = new Vector2(screenWidth/2, screenHeight/2),
            Zoom = 1.0f
        };

        while (!Raylib.WindowShouldClose())
        {
            // Gestion caméra...
            if (Raylib.IsKeyDown(KeyboardKey.Right)) camera.Target.X += 5;
            if (Raylib.IsKeyDown(KeyboardKey.Left)) camera.Target.X -= 5;
            if (Raylib.IsKeyDown(KeyboardKey.Up)) camera.Target.Y -= 5;
            if (Raylib.IsKeyDown(KeyboardKey.Down)) camera.Target.Y += 5;

            Raylib.BeginDrawing();
            Raylib.ClearBackground(Color.RayWhite);
            Raylib.BeginMode2D(camera);

            foreach (var layer in map.Layers)
            {
                if (layer.type != TiledLayerType.TileLayer) continue;

                for (int y = 0; y < layer.height; y++)
                {
                    for (int x = 0; x < layer.width; x++)
                    {
                        int index = y * layer.width + x;
                        int gid = layer.data[index];
                        
                        if (gid == 0) continue;

                        // Trouver le bon tileset pour ce GID
                        for (int i = tilesets.Count - 1; i >= 0; i--)
                        {
                            if (gid >= map.Tilesets[i].firstgid)
                            {
                                var tileRect = GetTileSourceRect(map,tilesets[i], gid);
                                Rectangle destRect = new(
                                    x * map.TileWidth,
                                    y * map.TileHeight,
                                    map.TileWidth,
                                    map.TileHeight
                                );

                                Raylib.DrawTexturePro(
                                    textures[i],
                                    tileRect,
                                    destRect,
                                    Vector2.Zero,
                                    0,
                                    Color.White
                                );
                                break;
                            }
                        }
                    }
                }
            }

            Raylib.EndMode2D();
            Raylib.DrawText("Deux tilesets chargés! Utilisez les flèches", 10, 10, 20, Color.DarkGray);
            Raylib.EndDrawing();
        }

        // Nettoyage
        foreach (var texture in textures)
            Raylib.UnloadTexture(texture);
        
        Raylib.CloseWindow();
    }

    static Rectangle GetTileSourceRect(TiledMap map,TiledTileset tileset, int gid)
    {
        int tileId = gid - map.Tilesets[0].firstgid;
        int tilesPerRow = tileset.Image.width / tileset.TileWidth;
        int row = tileId / tilesPerRow;
        int col = tileId % tilesPerRow;
        
        return new Rectangle(
            col * tileset.TileWidth,
            row * tileset.TileHeight,
            tileset.TileWidth,
            tileset.TileHeight
        );
    }
}