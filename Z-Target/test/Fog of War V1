using System.Numerics;
using Raylib_cs;

public class FogOfWar
{
    private RenderTexture2D fogTexture;
    private int visionRadius;
    public int VisionRadius => visionRadius;
    private Color fogColor;
    
    public FogOfWar(int screenWidth, int screenHeight, int radius, Color color)
    {
        fogTexture = Raylib.LoadRenderTexture(screenWidth, screenHeight);
        visionRadius = radius;
        fogColor = color;
        
        // Initialiser la texture avec un brouillard complet
        Raylib.BeginTextureMode(fogTexture);
        Raylib.ClearBackground(fogColor);
        Raylib.EndTextureMode();
    }

    public void Update(Vector2 playerPosition)
    {
        // Dessiner le masque de vision
        Raylib.BeginTextureMode(fogTexture);
        {
            // Effacer seulement la zone autour du joueur
            Raylib.DrawCircleGradient(
                (int)playerPosition.X, 
                (int)playerPosition.Y, 
                visionRadius,
                Raylib.Fade(Color.White, 0f),  // Transparent au centre
                Raylib.Fade(Color.White, 1f)); // Opaque à l'extérieur
        }
        Raylib.EndTextureMode();
    }

    public void Render()
    {
        // Appliquer le fog of war sur toute la scène
        Raylib.DrawTextureRec(
            fogTexture.Texture,
            new Rectangle(0, 0, fogTexture.Texture.Width, -fogTexture.Texture.Height),
            Vector2.Zero,
            fogColor);
    }

    public void Unload()
    {
        Raylib.UnloadRenderTexture(fogTexture);
    }
}

class Program
{
    static void Main()
    {
        const int screenWidth = 1200;
        const int screenHeight = 800;
        
        Raylib.InitWindow(screenWidth, screenHeight, "Zombie Game with Fog of War");
        Raylib.SetTargetFPS(60);

        // Joueur
        Vector2 playerPos = new(screenWidth/2, screenHeight/2);
        Vector2 playerSize = new(50, 50);
        float playerSpeed = 400f;
        
        // Zombies
        List<Vector2> zombies = new();
        for (int i = 0; i < 5; i++)
            zombies.Add(new Vector2(
                Raylib.GetRandomValue(0, screenWidth),
                Raylib.GetRandomValue(0, screenHeight)));

        // Fog of War
        FogOfWar fog = new(screenWidth, screenHeight, 200, new Color(0, 0, 0, 200));

        while (!Raylib.WindowShouldClose())
        {
            float deltaTime = Raylib.GetFrameTime();
            
            // Contrôles du joueur
            Vector2 direction = new(
                Raylib.IsKeyDown(KeyboardKey.D) ? 1 : Raylib.IsKeyDown(KeyboardKey.A) ? -1 : 0,
                Raylib.IsKeyDown(KeyboardKey.W) ? -1 : Raylib.IsKeyDown(KeyboardKey.S) ? 1 : 0);
            
            if (direction != Vector2.Zero)
            {
                direction = Vector2.Normalize(direction);
                playerPos += direction * playerSpeed * deltaTime;
                playerPos.X = Math.Clamp(playerPos.X, 0, screenWidth);
                playerPos.Y = Math.Clamp(playerPos.Y, 0, screenHeight);
            }

            // Rotation vers la souris
            Vector2 mousePos = Raylib.GetMousePosition();
            float angle = MathF.Atan2(mousePos.Y - playerPos.Y, mousePos.X - playerPos.X) * (180/MathF.PI);

            // IA des zombies (seulement visibles dans le fog)
            for (int i = 0; i < zombies.Count; i++)
            {
                if (Vector2.Distance(playerPos, zombies[i]) < fog.VisionRadius)
                {
                    Vector2 zombieDir = Vector2.Normalize(playerPos - zombies[i]);
                    zombies[i] += zombieDir * 100f * deltaTime;
                }
            }

            // Mise à jour du fog
            fog.Update(playerPos);

            // Rendu
            Raylib.BeginDrawing();
            Raylib.ClearBackground(Color.DarkGray);
            
            // 1. Dessiner les éléments du jeu
            foreach (var zombie in zombies)
                Raylib.DrawCircleV(zombie, 25, Color.Red);
            
            Raylib.DrawRectanglePro(
                new Rectangle(playerPos.X, playerPos.Y, playerSize.X, playerSize.Y),
                playerSize/2, angle, Color.SkyBlue);

            // 2. Appliquer le fog of war
            fog.Render();

            // 3. UI
            Raylib.DrawText($"Zombies: {zombies.Count}", 20, 20, 30, Color.White);
            Raylib.DrawFPS(10, 10);

            Raylib.EndDrawing();
        }

        fog.Unload();
        Raylib.CloseWindow();
    }
}