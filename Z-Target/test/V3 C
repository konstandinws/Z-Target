
using Raylib_cs;
using System.Numerics;
using System.Collections.Generic;
using System;

class Program
{
    enum GameState { Menu, Playing, GameOver }

    static void Main()
    {
        const int screenWidth = 1200;
        const int screenHeight = 800;
        Raylib.InitWindow(screenWidth, screenHeight, "Zombie Shooter");
        Raylib.SetTargetFPS(60);

        GameState state = GameState.Menu;

        Vector2 playerPos = new Vector2(screenWidth / 2, screenHeight / 2);
        Vector2 size = new Vector2(50, 50);
        Vector2 direction = new Vector2(0, 0);
        float speed = 400.0f;
        float zombieBaseSpeed = 100.0f;
        int zombieBaseHealth = 3;

        int ammo = 12;
        int maxAmmo = 12;
        bool reloading = false;
        float reloadTime = 2f;
        float reloadTimer = 0f;

        List<Vector2> bullets = new List<Vector2>();
        List<Vector2> bulletDirections = new List<Vector2>();
        float bulletSpeed = 1600.0f;

        List<Vector2> zombies = new List<Vector2>();
        List<int> zombieHealths = new List<int>();

        float zombieSpawnTimer = 0f;
        float zombieSpawnInterval = 0.5f;

        int zombiesToSpawn = 5;
        int zombiesSpawned = 0;
        int round = 1;

        float playerHitCooldown = 0.5f;
        float playerHitTimer = 0f;
        int playerHits = 0;
        float redScreenAlpha = 0f;
        float regenTimer = 0f;
        float regenDelay = 3f;

        bool gameStarted = false;

        while (!Raylib.WindowShouldClose())
        {
            float dt = Raylib.GetFrameTime();
            Raylib.BeginDrawing();
            Raylib.ClearBackground(Color.White);

            if (state == GameState.Menu)
            {
                Raylib.DrawText("Zombie Shooter", screenWidth / 2 - 150, screenHeight / 3, 40, Color.DarkGray);
                Raylib.DrawText("Press ENTER to Play", screenWidth / 2 - 120, screenHeight / 2, 20, Color.Black);
                Raylib.DrawText("Press ESC to Quit", screenWidth / 2 - 110, screenHeight / 2 + 30, 20, Color.Black);

                if (Raylib.IsKeyPressed(KeyboardKey.Enter)) state = GameState.Playing;
            }
            else if (state == GameState.Playing)
            {
                // Move
                direction = Vector2.Zero;
                if (Raylib.IsKeyDown(KeyboardKey.W)) direction.Y -= 1;
                if (Raylib.IsKeyDown(KeyboardKey.S)) direction.Y += 1;
                if (Raylib.IsKeyDown(KeyboardKey.A)) direction.X -= 1;
                if (Raylib.IsKeyDown(KeyboardKey.D)) direction.X += 1;
                if (direction != Vector2.Zero) direction = Vector2.Normalize(direction);
                playerPos += direction * speed * dt;

                // Rotation
                Vector2 mouse = Raylib.GetMousePosition();
                float angle = MathF.Atan2(mouse.Y - playerPos.Y, mouse.X - playerPos.X) * (180 / MathF.PI);

                // Bullets
                if (Raylib.IsMouseButtonPressed(MouseButton.Left) && ammo > 0 && !reloading)
                {
                    Vector2 dir = Vector2.Normalize(mouse - playerPos);
                    bullets.Add(playerPos);
                    bulletDirections.Add(dir);
                    ammo--;
                }

                if (ammo == 0 && !reloading)
                {
                    Raylib.DrawText("RECHARGER !", screenWidth - 180, screenHeight - 80, 20, Color.Red);
                }

                if (Raylib.IsKeyPressed(KeyboardKey.R) && ammo < maxAmmo && !reloading)
                {
                    reloading = true;
                    reloadTimer = 0f;
                }

                if (reloading)
                {
                    reloadTimer += dt;
                    Raylib.DrawCircleSector(new Vector2(screenWidth - 60, screenHeight - 60), 30, 0, 360 * (reloadTimer / reloadTime), 60, Color.DarkGray);
                    if (reloadTimer >= reloadTime)
                    {
                        ammo = maxAmmo;
                        reloading = false;
                    }
                }

                for (int i = 0; i < bullets.Count; i++)
                {
                    bullets[i] += bulletDirections[i] * bulletSpeed * dt;
                    Raylib.DrawCircle((int)bullets[i].X, (int)bullets[i].Y, 5, Color.Black);
                    if (bullets[i].X < 0 || bullets[i].X > screenWidth || bullets[i].Y < 0 || bullets[i].Y > screenHeight)
                    {
                        bullets.RemoveAt(i);
                        bulletDirections.RemoveAt(i);
                        i--;
                    }
                }

                // Spawn zombies gradually
                zombieSpawnTimer += dt;
                if (zombiesSpawned < zombiesToSpawn && zombieSpawnTimer >= zombieSpawnInterval)
                {
                    zombieSpawnTimer = 0f;
                    Vector2 spawn = new Vector2(Raylib.GetRandomValue(-100, screenWidth + 100), Raylib.GetRandomValue(-100, screenHeight + 100));
                    zombies.Add(spawn);
                    zombieHealths.Add(zombieBaseHealth + (round / 3));
                    zombiesSpawned++;
                }

                // Update zombies
                for (int i = 0; i < zombies.Count; i++)
                {
                    Vector2 dir = Vector2.Normalize(playerPos - zombies[i]);
                    float zSpeed = zombieBaseSpeed + (round / 3) * 20;
                    zombies[i] += dir * zSpeed * dt;

                    Raylib.DrawCircle((int)zombies[i].X, (int)zombies[i].Y, 25, Color.Red);
                }

                // Bullet hits zombie
                for (int i = 0; i < zombies.Count; i++)
                {
                    for (int j = 0; j < bullets.Count; j++)
                    {
                        if (Vector2.Distance(zombies[i], bullets[j]) < 25)
                        {
                            zombieHealths[i]--;
                            bullets.RemoveAt(j);
                            bulletDirections.RemoveAt(j);
                            j--;
                            if (zombieHealths[i] <= 0)
                            {
                                zombies.RemoveAt(i);
                                zombieHealths.RemoveAt(i);
                                i--;
                                break;
                            }
                        }
                    }
                }

                // Zombie hits player
                playerHitTimer -= dt;
                regenTimer += dt;

                for (int i = 0; i < zombies.Count; i++)
                {
                    if (Vector2.Distance(zombies[i], playerPos) < 40 && playerHitTimer <= 0)
                    {
                        playerHits++;
                        redScreenAlpha = 0.6f;
                        playerHitTimer = playerHitCooldown;
                        regenTimer = 0f;
                        if (playerHits >= 3)
                        {
                            state = GameState.GameOver;
                        }
                    }
                }

                if (regenTimer >= regenDelay && playerHits > 0)
                {
                    playerHits--;
                    regenTimer = 0f;
                }

                if (redScreenAlpha > 0)
                {
                    Raylib.DrawRectangle(0, 0, screenWidth, screenHeight, ColorAlpha(Color.Red, redScreenAlpha));
                    redScreenAlpha -= dt;
                }

                Raylib.DrawRectanglePro(new Rectangle(playerPos.X, playerPos.Y, size.X, size.Y), new Vector2(size.X / 2, size.Y / 2), angle, Color.Maroon);

                // UI
                Raylib.DrawText($"Round: {round}", 10, 10, 20, Color.Black);
                Raylib.DrawText($"Ammo: {ammo}/{maxAmmo}", screenWidth - 150, screenHeight - 30, 20, Color.Black);

                if (zombiesSpawned == zombiesToSpawn && zombies.Count == 0)
                {
                    round++;
                    zombiesToSpawn = 5 + round * 2;
                    zombiesSpawned = 0;
                }
            }
            else if (state == GameState.GameOver)
            {
                Raylib.DrawText("GAME OVER", screenWidth / 2 - 100, screenHeight / 2, 40, Color.Red);
                Raylib.DrawText("Press ENTER to return to Menu", screenWidth / 2 - 150, screenHeight / 2 + 50, 20, Color.DarkGray);
                if (Raylib.IsKeyPressed(KeyboardKey.Enter))
                {
                    state = GameState.Menu;
                    playerPos = new Vector2(screenWidth / 2, screenHeight / 2);
                    zombies.Clear();
                    bullets.Clear();
                    bulletDirections.Clear();
                    zombieHealths.Clear();
                    round = 1;
                    zombiesSpawned = 0;
                    zombiesToSpawn = 5;
                    playerHits = 0;
                    ammo = maxAmmo;
                }
            }

            Raylib.EndDrawing();
        }

        Raylib.CloseWindow();
    }

    static Color ColorAlpha(Color color, float alpha)
    {
        byte newAlpha = (byte)(Math.Clamp(alpha, 0f, 1f) * 255);
        return new Color(color.R, color.G, color.B, newAlpha);
    }
}
