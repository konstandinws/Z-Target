using Raylib_cs;
using System.Numerics;
using System;
using System.Collections.Generic;

class Program
{
    // Global settings
    const int screenWidth = 1280;
    const int screenHeight = 720;
    const int maxAmmo = 12;
    const float reloadTime = 2.0f;
    const float zombieSpawnInterval = 0.6f;

    // Game state
    static int currentRound = 1;
    static int score = 0;
    static bool isReloading = false;
    static float reloadTimer = 0;
    static int ammo = maxAmmo;
    static int playerHealth = 3;
    static float damageCooldown = 0;
    static float regenTimer = 0;
    static bool isGameOver = false;
    static bool inGame = false;
    static bool showRoundTransition = false;
    static float roundTransitionTimer = 0;

    // Buffs
    static bool hasQuickReload = false;
    static bool hasSelfRevive = false;

    // Player
    static Vector2 playerPos = new Vector2(screenWidth / 2, screenHeight / 2);
    static Vector2 playerSize = new Vector2(50, 50);
    static float playerSpeed = 300f;

    // Lists
    static List<Zombie> zombies = new();
    static List<Bullet> bullets = new();

    // Spawn points (outside screen)
    static Vector2[] spawnPoints = new Vector2[]
    {
        new Vector2(-50, -50),
        new Vector2(screenWidth + 50, -50),
        new Vector2(-50, screenHeight + 50),
        new Vector2(screenWidth + 50, screenHeight + 50),
        new Vector2(screenWidth / 2, -100)
    };

    // Buff Machines
    static Vector2 quickReloadMachine = new Vector2(150, 150);
    static Vector2 selfReviveMachine = new Vector2(screenWidth - 150, 150);

    static void Main()
    {
        Raylib.InitWindow(screenWidth, screenHeight, "Zombie Shooter");
        Raylib.SetTargetFPS(60);

        float zombieSpawnTimer = 0;

        while (!Raylib.WindowShouldClose())
        {
            float dt = Raylib.GetFrameTime();
            Raylib.BeginDrawing();
            Raylib.ClearBackground(Color.White);

            if (!inGame)
            {
                DrawMenu();
                if (Raylib.IsKeyPressed(KeyboardKey.Enter))
                {
                    ResetGame();
                }
                else if (Raylib.IsKeyPressed(KeyboardKey.Escape))
                {
                    break;
                }
                Raylib.EndDrawing();
                continue;
            }

            if (isGameOver)
            {
                DrawGameOver();
                Raylib.EndDrawing();
                continue;
            }

            // PLAYER MOVEMENT
            Vector2 move = Vector2.Zero;
            if (Raylib.IsKeyDown(KeyboardKey.W)) move.Y -= 1;
            if (Raylib.IsKeyDown(KeyboardKey.S)) move.Y += 1;
            if (Raylib.IsKeyDown(KeyboardKey.A)) move.X -= 1;
            if (Raylib.IsKeyDown(KeyboardKey.D)) move.X += 1;
            if (move != Vector2.Zero)
            {
                move = Vector2.Normalize(move);
                playerPos += move * playerSpeed * dt;
            }

            // SHOOTING
            if (Raylib.IsMouseButtonPressed(MouseButton.Left) && !isReloading && ammo > 0)
            {
                Vector2 mousePos = Raylib.GetMousePosition();
                Vector2 dir = Vector2.Normalize(mousePos - playerPos);
                bullets.Add(new Bullet(playerPos, dir));
                ammo--;
                if (ammo == 0) isReloading = true;
            }

            // RELOADING
            if (Raylib.IsKeyPressed(KeyboardKey.R) && !isReloading && ammo < maxAmmo)
            {
                isReloading = true;
            }
            if (isReloading)
            {
                reloadTimer += dt;
                float totalReloadTime = hasQuickReload ? reloadTime / 2 : reloadTime;
                if (reloadTimer >= totalReloadTime)
                {
                    ammo = maxAmmo;
                    reloadTimer = 0;
                    isReloading = false;
                }
            }

            // SPAWN ZOMBIES
            zombieSpawnTimer += dt;
            if (zombieSpawnTimer >= zombieSpawnInterval && zombies.Count < currentRound * 5)
            {
                zombieSpawnTimer = 0;
                Vector2 spawn = spawnPoints[Raylib.GetRandomValue(0, spawnPoints.Length - 1)];
                int health = 3 + (currentRound / 3);
                float speed = 100 + (currentRound / 3) * 20;
                zombies.Add(new Zombie(spawn, health, speed));
            }

            // UPDATE BULLETS
            for (int i = bullets.Count - 1; i >= 0; i--)
            {
                bullets[i].Update(dt);
                if (bullets[i].IsOffScreen(screenWidth, screenHeight))
                    bullets.RemoveAt(i);
            }

            // UPDATE ZOMBIES
            for (int i = zombies.Count - 1; i >= 0; i--)
            {
                zombies[i].Update(dt, playerPos, zombies);
                if (zombies[i].CheckCollision(playerPos, playerSize))
                {
                    if (damageCooldown <= 0)
                    {
                        playerHealth--;
                        damageCooldown = 0.5f;
                        if (playerHealth <= 0)
                        {
                            if (hasSelfRevive)
                            {
                                playerHealth = 3;
                                hasSelfRevive = false;
                                zombies.ForEach(z => z.KnockBackFrom(playerPos));
                            }
                            else
                            {
                                isGameOver = true;
                            }
                        }
                    }
                }
                foreach (var bullet in bullets)
                {
                    if (zombies[i].IsHit(bullet.Position))
                    {
                        zombies[i].TakeDamage();
                        bullet.IsUsed = true;
                        if (zombies[i].IsDead)
                        {
                            zombies.RemoveAt(i);
                            score += 10;
                        }
                        break;
                    }
                }
            }

            bullets.RemoveAll(b => b.IsUsed);

            // ROUND SYSTEM
            if (zombies.Count == 0 && zombieSpawnTimer >= 1f)
            {
                currentRound++;
                showRoundTransition = true;
                roundTransitionTimer = 2f;
            }

            if (showRoundTransition)
            {
                roundTransitionTimer -= dt;
                if ((int)(roundTransitionTimer * 2) % 2 == 0)
                    Raylib.DrawText($"Round {currentRound}", screenWidth / 2 - 100, screenHeight / 2, 50, Color.Red);
                if (roundTransitionTimer <= 0)
                    showRoundTransition = false;
            }

            // DAMAGE COOLDOWN + REGEN
            if (damageCooldown > 0) damageCooldown -= dt;
            else regenTimer += dt;
            if (regenTimer >= 3f && playerHealth < 3)
            {
                playerHealth++;
                regenTimer = 0;
            }

            // DRAWING
            DrawGameUI();
            DrawBuffMachines();
            bullets.ForEach(b => b.Draw());
            zombies.ForEach(z => z.Draw());
            Raylib.DrawRectanglePro(new Rectangle(playerPos.X, playerPos.Y, playerSize.X, playerSize.Y), playerSize / 2, 0, Color.DARKBLUE);

            Raylib.EndDrawing();
        }

        Raylib.CloseWindow();
    }

    static void ResetGame()
    {
        inGame = true;
        isGameOver = false;
        currentRound = 1;
        score = 0;
        playerHealth = 3;
        ammo = maxAmmo;
        reloadTimer = 0;
        isReloading = false;
        zombies.Clear();
        bullets.Clear();
        hasQuickReload = false;
        hasSelfRevive = false;
    }

    static void DrawMenu()
    {
        Raylib.DrawText("ZOMBIE SHOOTER", screenWidth / 2 - 200, screenHeight / 2 - 100, 50, Color.BLACK);
        Raylib.DrawText("Press ENTER to Start", screenWidth / 2 - 160, screenHeight / 2, 30, Color.DARKGRAY);
        Raylib.DrawText("Press ESC to Quit", screenWidth / 2 - 140, screenHeight / 2 + 50, 30, Color.DARKGRAY);
    }

    static void DrawGameOver()
    {
        Raylib.DrawRectangle(0, 0, screenWidth, screenHeight, ColorAlpha(Color.RED, 0.5f));
        Raylib.DrawText("GAME OVER", screenWidth / 2 - 150, screenHeight / 2 - 50, 50, Color.BLACK);
        Raylib.DrawText("Score: " + score, screenWidth / 2 - 100, screenHeight / 2 + 10, 30, Color.BLACK);
        Raylib.DrawText("Press ENTER to Restart", screenWidth / 2 - 160, screenHeight / 2 + 60, 30, Color.DARKGRAY);
    }

    static void DrawGameUI()
    {
        Raylib.DrawText("Round: " + currentRound, 10, 10, 30, Color.DARKRED);
        Raylib.DrawText("Score: " + score, 10, 50, 30, Color.BLACK);
        Raylib.DrawText("Ammo: " + ammo + "/" + maxAmmo, screenWidth - 150, screenHeight - 40, 25, Color.BLACK);
        if (isReloading)
        {
            Raylib.DrawText("Reloading...", screenWidth - 200, screenHeight - 80, 25, Color.DARKGRAY);
            float percent = reloadTimer / (hasQuickReload ? reloadTime / 2 : reloadTime);
            Raylib.DrawCircleSector(new Vector2(screenWidth - 100, screenHeight - 100), 30, 0, percent * 360, 20, Color.GRAY);
        }
    }

    static void DrawBuffMachines()
    {
        Raylib.DrawCircleV(quickReloadMachine, 30, Color.SKYBLUE);
        Raylib.DrawText("F: Fast Reload", (int)quickReloadMachine.X - 40, (int)quickReloadMachine.Y - 50, 15, Color.BLACK);

        Raylib.DrawCircleV(selfReviveMachine, 30, Color.LIGHTGRAY);
        Raylib.DrawText("F: Self Revive", (int)selfReviveMachine.X - 40, (int)selfReviveMachine.Y - 50, 15, Color.BLACK);

        if (Vector2.Distance(playerPos, quickReloadMachine) < 50 && Raylib.IsKeyPressed(KeyboardKey.F))
            hasQuickReload = true;

        if (Vector2.Distance(playerPos, selfReviveMachine) < 50 && Raylib.IsKeyPressed(KeyboardKey.F))
            hasSelfRevive = true;
    }

    static Color ColorAlpha(Color color, float alpha)
    {
        return new Color(color.r, color.g, color.b, (byte)(Math.Clamp(alpha, 0f, 1f) * 255));
    }
}

