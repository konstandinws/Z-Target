using Raylib_cs;
 using System.Numerics;
 using System.Collections.Generic;
 using System;

 // Structure simple pour une particule de fumée
 struct SmokeParticle
 {
     public Vector2 Position;
     public Vector2 Velocity;
     public float Lifespan; // Temps écoulé depuis la création
     public float MaxLifespan; // Durée de vie maximale
     public float Size;
     public Color Tint;
 }

 class Program
 {
     enum GameState { Menu, Playing, GameOver }

     // --- Constantes et Variables Globales ---
     const int screenWidth = 1200;
     const int screenHeight = 800;

     // Variables Voiture Sprite Stack
     const int carSliceCount = 8;
     const float carScale = 6.0f; // Ajusté pour être peut-être plus petit dans le jeu
     const float carRotationSpeed = 30f; // Degrés par seconde
     static Vector2 carPosition = new Vector2(200, 200); // Position fixe pour l'exemple
     static Texture2D[] carSlices = new Texture2D[carSliceCount];
     static float carCurrentAngle = 0f;
     static int carBaseSliceOffset = 3; // Espacement vertical des tranches
     static int round = 1;
     static float sprintTimer = 0f;
     static float sprintDuration = 3f;
    static float sprintCooldown = 5f;
    static float sprintCooldownTimer = 0f;
     static bool canSprint = true;
     static int zombieBaseHealth = 3;
     // Variables Effet Fumée
     static List<SmokeParticle> smokeParticles = new List<SmokeParticle>();
     static Random random = new Random(); // Pour la dispersion de la fumée
     static    int zombiesToSpawn = 5;
      static   int zombiesSpawned = 0;
     static void Main()
     {
         Raylib.InitWindow(screenWidth, screenHeight, "Zombie Shooter with Car");
         Raylib.SetTargetFPS(60);

         // --- Chargement Ressources ---
         LoadCarTextures(); // Charger les textures de la voiture

         // --- Initialisation du Jeu ---
         GameState state = GameState.Menu;

         Vector2 playerPos = new Vector2(screenWidth / 2, screenHeight / 2);
         Vector2 playerSize = new Vector2(50, 50); // Utiliser pour le dessin ET la collision
         Vector2 direction = new Vector2(0, 0);
         float PlayerSpeed = 400.0f;
         float PlayerSpeedModifier = 1.0f;
         float zombieBaseSpeed = 100.0f;
         

         int ammo = 12;
         int maxAmmo = 12;
         bool reloading = false;
         float reloadTime = 2f;
         float reloadTimer = 0f;

         List<Vector2> bullets = new List<Vector2>();
         List<Vector2> bulletDirections = new List<Vector2>();
         float bulletSpeed = 1600.0f;

         List<Vector2> zombies = new List<Vector2>();
         List<int> zombieHealths = new List<int>();

         float zombieSpawnTimer = 0f;
         float zombieSpawnInterval = 0.5f;

         
         

         float playerHitCooldown = 0.5f;
         float playerHitTimer = 0f;
         int playerHits = 0;
         float redScreenAlpha = 0f;
         float regenTimer = 0f;
         float regenDelay = 3f;

         

         // --- Boucle Principale ---
         while (!Raylib.WindowShouldClose())
         {
             float dt = Raylib.GetFrameTime();

             // --- Mise à jour ---
             switch (state)
             {
                 case GameState.Menu:
                     if (Raylib.IsKeyPressed(KeyboardKey.Enter)) state = GameState.Playing;
                     break;

                 case GameState.Playing:
                     UpdatePlaying(dt, ref playerPos, playerSize, ref direction, PlayerSpeed, ref PlayerSpeedModifier,
                                   ref sprintTimer, sprintDuration, ref canSprint, ref sprintCooldownTimer, sprintCooldown,
                                   ref reloading, ref ammo, maxAmmo, reloadTime, ref reloadTimer,
                                   bullets, bulletDirections, bulletSpeed,
                                   zombies, zombieHealths, zombieBaseSpeed, round,
                                   ref zombieSpawnTimer, zombieSpawnInterval, ref zombiesSpawned, ref zombiesToSpawn,
                                   ref playerHitTimer, ref playerHits, playerHitCooldown, ref redScreenAlpha, ref regenTimer, regenDelay,
                                   ref state); // Passer l'état pour GameOver

                    // Mettre à jour l'angle de la voiture
                    carCurrentAngle += carRotationSpeed * dt;
                    carCurrentAngle = (carCurrentAngle % 360 + 360) % 360; // Garder dans [0, 360)

                    // Mettre à jour les particules de fumée
                    UpdateSmokeParticles(dt);

                    // Détection de collision Joueur vs Voiture
                    CheckPlayerCarCollision(playerPos, playerSize);

                     break;

                 case GameState.GameOver:
                     if (Raylib.IsKeyPressed(KeyboardKey.Enter))
                     {
                         ResetGame(ref state, ref playerPos, ref zombies, ref bullets, ref bulletDirections,
                                   ref zombieHealths, ref round, ref zombiesSpawned, ref zombiesToSpawn,
                                   ref playerHits, ref ammo, maxAmmo, ref canSprint, ref sprintTimer, ref sprintCooldownTimer);
                         state = GameState.Menu;
                     }
                     break;
             }

             // --- Dessin ---
             Raylib.BeginDrawing();
             Raylib.ClearBackground(Color.White); // Fond blanc par défaut

             switch (state)
             {
                 case GameState.Menu:
                     DrawMenu();
                     break;

                 case GameState.Playing:
                     DrawPlaying(playerPos, playerSize, direction, ammo, maxAmmo, reloading, reloadTimer, reloadTime,
                                 bullets, zombies, round, playerHits, redScreenAlpha, sprintTimer, sprintDuration);

                     // Dessiner la voiture
                     DrawCar(carPosition, carCurrentAngle, carScale, carBaseSliceOffset, carSlices);

                     // Dessiner les particules de fumée
                     DrawSmokeParticles();

                     break;

                 case GameState.GameOver:
                     DrawGameOver();
                     break;
             }

             Raylib.EndDrawing();
         }

         // --- Nettoyage ---
         UnloadCarTextures();
         Raylib.CloseWindow();
     }

     // --- Fonctions de Mise à Jour (pour Playing) ---
     static void UpdatePlaying(float dt, ref Vector2 playerPos, Vector2 playerSize, ref Vector2 direction, float PlayerSpeed, ref float PlayerSpeedModifier,
                               ref float sprintTimer, float sprintDuration, ref bool canSprint, ref float sprintCooldownTimer, float sprintCooldown,
                               ref bool reloading, ref int ammo, int maxAmmo, float reloadTime, ref float reloadTimer,
                               List<Vector2> bullets, List<Vector2> bulletDirections, float bulletSpeed,
                               List<Vector2> zombies, List<int> zombieHealths, float zombieBaseSpeed, int round,
                               ref float zombieSpawnTimer, float zombieSpawnInterval, ref int zombiesSpawned, ref int zombiesToSpawn,
                               ref float playerHitTimer, ref int playerHits, float playerHitCooldown, ref float redScreenAlpha, ref float regenTimer, float regenDelay,
                               ref GameState state) // Ajout de state pour pouvoir passer à GameOver
     {
         // --- Mouvement Joueur ---
         direction = Vector2.Zero;
         if (Raylib.IsKeyDown(KeyboardKey.W)) direction.Y -= 1;
         if (Raylib.IsKeyDown(KeyboardKey.S)) direction.Y += 1;
         if (Raylib.IsKeyDown(KeyboardKey.A)) direction.X -= 1;
         if (Raylib.IsKeyDown(KeyboardKey.D)) direction.X += 1;
         if (direction != Vector2.Zero) direction = Vector2.Normalize(direction);

         // --- Sprint ---
         PlayerSpeedModifier = 1.0f;
         if (Raylib.IsKeyDown(KeyboardKey.LeftShift) && canSprint && !reloading) {
             if (sprintTimer < sprintDuration) {
                 PlayerSpeedModifier = 1.5f;
                 sprintTimer += dt;
             } else { // Fin du sprint, début cooldown
                 canSprint = false;
                 sprintCooldownTimer = 0f; // Démarrer le timer de cooldown
             }
         } else { // Pas de sprint ou en cooldown
             if (!canSprint) { // En cooldown
                 sprintCooldownTimer += dt;
                 if (sprintCooldownTimer >= sprintCooldown) {
                     canSprint = true;
                     sprintTimer = 0f; // Réinitialiser la durée de sprint dispo
                     sprintCooldownTimer = 0f;
                 }
             } else if (sprintTimer > 0f) { // Récupération passive si on ne sprinte pas
                 sprintTimer -= dt / 2f; // Récupère plus lentement qu'il ne se vide
                 if (sprintTimer < 0f) sprintTimer = 0f;
             }
         }

         playerPos += direction * PlayerSpeed * PlayerSpeedModifier * dt;
         // Garder le joueur dans l'écran (optionnel)
         playerPos.X = Math.Clamp(playerPos.X, playerSize.X / 2, screenWidth - playerSize.X / 2);
         playerPos.Y = Math.Clamp(playerPos.Y, playerSize.Y / 2, screenHeight - playerSize.Y / 2);


         // --- Tir ---
         Vector2 mouse = Raylib.GetMousePosition();
         if (Raylib.IsMouseButtonPressed(MouseButton.Left) && ammo > 0 && !reloading)
         {
             Vector2 dir = Vector2.Normalize(mouse - playerPos);
             bullets.Add(playerPos);
             bulletDirections.Add(dir);
             ammo--;
         }

         // --- Rechargement ---
         if (Raylib.IsKeyPressed(KeyboardKey.R) && ammo < maxAmmo && !reloading)
         {
             reloading = true;
             reloadTimer = 0f;
         }
         if (reloading)
         {
             reloadTimer += dt;
             if (reloadTimer >= reloadTime)
             {
                 ammo = maxAmmo;
                 reloading = false;
             }
         }

         // --- Mise à jour Balles & Collisions Balles/Zombies ---
         for (int i = bullets.Count - 1; i >= 0; i--)
         {
             bullets[i] += bulletDirections[i] * bulletSpeed * dt;
             bool removed = false;

             // Collision avec Zombies
             for (int j = zombies.Count - 1; j >= 0; j--)
             {
                 if (Vector2.Distance(zombies[j], bullets[i]) < 25 + 5) // Rayon zombie + rayon balle
                 {
                     zombieHealths[j]--;
                     bullets.RemoveAt(i);
                     bulletDirections.RemoveAt(i);
                     removed = true;
                     if (zombieHealths[j] <= 0)
                     {
                         zombies.RemoveAt(j);
                         zombieHealths.RemoveAt(j);
                     }
                     break; // La balle ne peut toucher qu'un zombie
                 }
             }
             if (removed) continue; // Passer à la balle suivante si celle-ci a été retirée

             // Sortie de l'écran
             if (bullets[i].X < 0 || bullets[i].X > screenWidth || bullets[i].Y < 0 || bullets[i].Y > screenHeight)
             {
                 bullets.RemoveAt(i);
                 bulletDirections.RemoveAt(i);
             }
         }


        // --- Spawn Zombies ---
         zombieSpawnTimer += dt;
         if (zombiesSpawned < zombiesToSpawn && zombieSpawnTimer >= zombieSpawnInterval)
         {
             zombieSpawnTimer = 0f;
             // Spawn hors écran
             int side = random.Next(4);
             Vector2 spawnPos = Vector2.Zero;
             switch(side) {
                 case 0: spawnPos = new Vector2(random.Next(screenWidth), -50); break; // Haut
                 case 1: spawnPos = new Vector2(random.Next(screenWidth), screenHeight + 50); break; // Bas
                 case 2: spawnPos = new Vector2(-50, random.Next(screenHeight)); break; // Gauche
                 case 3: spawnPos = new Vector2(screenWidth + 50, random.Next(screenHeight)); break; // Droite
             }

             zombies.Add(spawnPos);
             zombieHealths.Add(zombieBaseHealth + (round / 3));
             zombiesSpawned++;
         }

         // --- Mise à jour Zombies & Collisions Zombies/Joueur ---
         playerHitTimer -= dt;
         bool playerGotHitThisFrame = false; // Pour la régénération

         for (int i = zombies.Count - 1; i >= 0; i--)
         {
             Vector2 zDir = Vector2.Normalize(playerPos - zombies[i]);
             float zSpeed = zombieBaseSpeed + (round * 10); // Augmente plus vite la vitesse
             zombies[i] += zDir * zSpeed * dt;

             // Collision avec joueur
             if (Vector2.Distance(zombies[i], playerPos) < 25 + playerSize.X / 2 && playerHitTimer <= 0) // Rayon zombie + demi-largeur joueur
             {
                 playerHits++;
                 redScreenAlpha = 0.6f;
                 playerHitTimer = playerHitCooldown;
                 playerGotHitThisFrame = true;
                 if (playerHits >= 3)
                 {
                     state = GameState.GameOver; // Changement d'état !
                     return; // Sortir de l'update si game over
                 }
             }
         }

         // --- Régénération Vie ---
         if (!playerGotHitThisFrame) {
             regenTimer += dt;
             if (regenTimer >= regenDelay && playerHits > 0)
             {
                 playerHits--;
                 regenTimer = 0f; // Réinitialiser pour le prochain point de vie
             }
         } else {
             regenTimer = 0f; // Réinitialiser si touché
         }


         // --- Fin de Manche ---
         if (zombiesSpawned == zombiesToSpawn && zombies.Count == 0)
         {
             round++;
             zombiesToSpawn = 5 + round * 3; // Plus de zombies par round
             zombieBaseHealth++;            // Zombies plus résistants
             zombieSpawnInterval = Math.Max(0.1f, 0.5f - round * 0.02f); // Spawn plus rapide
             zombiesSpawned = 0;
             // Bonus fin de manche? (Ex: munitions pleines)
             ammo = maxAmmo;
             reloading = false;
             reloadTimer = 0f;
         }

         // --- Effet écran rouge ---
         if (redScreenAlpha > 0)
         {
             redScreenAlpha -= dt * 1.5f; // Disparait plus vite
             if (redScreenAlpha < 0) redScreenAlpha = 0f;
         }
     }

     // --- Fonctions de Dessin ---
     static void DrawMenu()
     {
         Raylib.DrawText("Zombie Shooter", screenWidth / 2 - Raylib.MeasureText("Zombie Shooter", 40) / 2, screenHeight / 3, 40, Color.DarkGray);
         Raylib.DrawText("Press ENTER to Play", screenWidth / 2 - Raylib.MeasureText("Press ENTER to Play", 20) / 2, screenHeight / 2, 20, Color.Black);
         Raylib.DrawText("Press ESC to Quit", screenWidth / 2 - Raylib.MeasureText("Press ESC to Quit", 20) / 2, screenHeight / 2 + 30, 20, Color.Black);
     }

     static void DrawPlaying(Vector2 playerPos, Vector2 playerSize, Vector2 direction, int ammo, int maxAmmo, bool reloading, float reloadTimer, float reloadTime,
                             List<Vector2> bullets, List<Vector2> zombies, int round, int playerHits, float redScreenAlpha, float sprintTimer, float sprintDuration)
     {
        // Dessiner le joueur (rectangle qui tourne vers la souris)
        Vector2 mouse = Raylib.GetMousePosition();
        float playerAngle = MathF.Atan2(mouse.Y - playerPos.Y, mouse.X - playerPos.X) * Raylib.RAD2DEG;
        Raylib.DrawRectanglePro(new Rectangle(playerPos.X, playerPos.Y, playerSize.X, playerSize.Y), new Vector2(playerSize.X / 2, playerSize.Y / 2), playerAngle, Color.Maroon);

        // Dessiner les balles
        foreach (Vector2 bullet in bullets)
        {
            Raylib.DrawCircleV(bullet, 5, Color.Black);
        }

        // Dessiner les zombies
        foreach (Vector2 zombie in zombies)
        {
            Raylib.DrawCircleV(zombie, 25, Color.DarkGreen); // Couleur Zombie
             // Dessiner une petite barre de vie au dessus (optionnel)
             // float healthRatio = (float)zombieHealths[zombies.IndexOf(zombie)] / (zombieBaseHealth + (round/3)); // Attention, IndexOf est lent
             // Raylib.DrawRectangleV(new Vector2(zombie.X - 15, zombie.Y - 35), new Vector2(30 * healthRatio, 5), Color.Red);
             // Raylib.DrawRectangleLines((int)(zombie.X - 15), (int)(zombie.Y - 35), 30, 5, Color.Black);
        }

        // UI
        Raylib.DrawText($"Round: {round}", 10, 10, 20, Color.Black);
        Raylib.DrawText($"Zombies Left: {zombies.Count + (zombiesToSpawn - zombiesSpawned)}", 10, 35, 20, Color.Black); // Afficher total restant
        Raylib.DrawText($"Ammo: {ammo}/{maxAmmo}", screenWidth - 150, screenHeight - 30, 20, Color.Black);
        Raylib.DrawText($"Health Hits: {3 - playerHits}/3", screenWidth - 150, 10, 20, playerHits < 2 ? Color.Blue : Color.Red); // Indicateur de vie

        // Indicateur de rechargement
        if (reloading)
        {
            Raylib.DrawCircleSector(new Vector2(screenWidth - 60, screenHeight - 60), 30, -90, -90 + 360 * (reloadTimer / reloadTime), 32, ColorAlpha(Color.DarkGray, 0.7f));
            Raylib.DrawText("R", screenWidth - 65, screenHeight - 68, 20, Color.White);
        } else if (ammo == 0) {
             Raylib.DrawText("RELOAD!", screenWidth / 2 - Raylib.MeasureText("RELOAD!", 30)/2, 50, 30, Color.Red);
        }

        // Barre de sprint
         Raylib.DrawRectangle(10, screenHeight - 30, 150, 20, Color.LightGray);
         float sprintRatio = canSprint ? (sprintDuration - sprintTimer) / sprintDuration : 0; // Barre diminue qd on sprint
         Raylib.DrawRectangle(10, screenHeight - 30, (int)(150 * sprintRatio), 20, Color.Orange);
         if (!canSprint) { // Barre de cooldown
             float cooldownRatio = sprintCooldownTimer / sprintCooldown;
             Raylib.DrawRectangle(10, screenHeight - 30, (int)(150 * cooldownRatio), 20, ColorAlpha(Color.Red, 0.5f));
             Raylib.DrawText("Cooldown", 20, screenHeight - 28, 18, Color.White);
         } else {
            Raylib.DrawText("Sprint", 20, screenHeight - 28, 18, Color.Black);
         }


        // Effet écran rouge si touché
        if (redScreenAlpha > 0)
        {
            Raylib.DrawRectangle(0, 0, screenWidth, screenHeight, ColorAlpha(Color.Red, redScreenAlpha));
        }
     }

     static void DrawGameOver()
     {
         Raylib.DrawText("GAME OVER", screenWidth / 2 - Raylib.MeasureText("GAME OVER", 40) / 2, screenHeight / 2 - 40, 40, Color.Red);
         Raylib.DrawText($"You survived {round - 1} rounds!", screenWidth / 2 - Raylib.MeasureText($"You survived {round - 1} rounds!", 20) / 2, screenHeight / 2 + 10, 20, Color.Black);
         Raylib.DrawText("Press ENTER to return to Menu", screenWidth / 2 - Raylib.MeasureText("Press ENTER to return to Menu", 20) / 2, screenHeight / 2 + 50, 20, Color.DarkGray);
     }

     // --- Fonctions Voiture & Fumée ---

     static void LoadCarTextures()
     {
         for (int i = 0; i < carSliceCount; i++)
         {
             // !! IMPORTANT: Assure-toi que ce chemin est correct !!
             string path = $"C:/Users/Konstantinos/Desktop/Zombie Raylib/Z-Target/car/img_{i}.png";
             try
             {
                 carSlices[i] = Raylib.LoadTexture(path);
                 if (carSlices[i].Id == 0)
                 {
                     Raylib.TraceLog(TraceLogLevel.Warning, $"Failed to load car texture: {path}");
                 }
             }
             catch (Exception ex)
             {
                 Raylib.TraceLog(TraceLogLevel.Error, $"Exception loading car texture {path}: {ex.Message}");
                 // On pourrait vouloir quitter ou utiliser une texture par défaut ici
             }
         }
     }

     static void UnloadCarTextures()
     {
         foreach (Texture2D slice in carSlices)
         {
             if (slice.Id != 0) Raylib.UnloadTexture(slice);
         }
     }

     static void DrawCar(Vector2 position, float angle, float scale, int sliceOffset, Texture2D[] slices)
     {
         float angleRad = angle * Raylib.DEG2RAD;
         float sinAngle = MathF.Sin(angleRad);
         float cosAngle = MathF.Cos(angleRad);

         // Dessiner de bas (i=0) en haut (i=sliceCount-1)
         for (int i = 0; i < carSliceCount; i++)
         {
             Texture2D slice = slices[i];
             if (slice.Id == 0) continue; // Ne pas dessiner si texture non chargée

             // Position verticale relative au centre de la pile
             float relativeY = (i - (carSliceCount - 1) / 2.0f) * -sliceOffset;

             // Calcul des décalages pour l'effet 3D
             float offsetX = relativeY * sinAngle;
             float offsetY = relativeY * MathF.Abs(cosAngle); // Perspective verticale

             // Position finale de la tranche
             float drawX = position.X + offsetX;
             float drawY = position.Y + offsetY;

             Rectangle sourceRec = new Rectangle(0, 0, slice.Width, slice.Height);
             Rectangle destRec = new Rectangle(drawX, drawY, slice.Width * scale, slice.Height * scale);
             Vector2 origin = new Vector2(destRec.Width / 2f, destRec.Height / 2f);

             // Dessiner la tranche sans rotation individuelle (angle = 0)
             Raylib.DrawTexturePro(slice, sourceRec, destRec, origin, 0, Color.White);
         }
     }

    static void CheckPlayerCarCollision(Vector2 playerPos, Vector2 playerSize)
    {
        // Collision simple : cercle du joueur vs cercle de la voiture
        float playerRadius = playerSize.X / 2f;
        // Estimation du rayon de la voiture (un peu plus grand que la base)
        float carRadius = (carSlices.Length > 0 && carSlices[0].Id != 0 ? carSlices[0].Width * carScale / 2f : 20f) + 10f;

        if (Raylib.CheckCollisionCircles(playerPos, playerRadius, carPosition, carRadius))
        {
            // Générer des particules de fumée lors de la collision
            SpawnSmokeParticles(carPosition, 20); // Génère 20 particules
        }
    }


     static void SpawnSmokeParticles(Vector2 origin, int count)
     {
         for (int i = 0; i < count; i++)
         {
             float angle = (float)(random.NextDouble() * Math.PI * 2); // Angle aléatoire
             float speed = (float)(random.NextDouble() * 50 + 20);     // Vitesse initiale aléatoire
             float maxLife = (float)(random.NextDouble() * 1.5 + 0.5); // Durée de vie aléatoire (0.5s à 2s)
             float startSize = (float)(random.NextDouble() * 5 + 5);   // Taille initiale aléatoire

             smokeParticles.Add(new SmokeParticle
             {
                 Position = origin + new Vector2((float)random.NextDouble()*10-5, (float)random.NextDouble()*10-5), // Petit décalage initial
                 Velocity = new Vector2(MathF.Cos(angle) * speed, MathF.Sin(angle) * speed),
                 Lifespan = 0f,
                 MaxLifespan = maxLife,
                 Size = startSize,
                 Tint = Color.Green // Fumée verte
             });
         }
     }

     static void UpdateSmokeParticles(float dt)
     {
         for (int i = smokeParticles.Count - 1; i >= 0; i--)
         {
             SmokeParticle p = smokeParticles[i]; // Copie de la structure

             p.Lifespan += dt;
             if (p.Lifespan >= p.MaxLifespan)
             {
                 smokeParticles.RemoveAt(i);
             }
             else
             {
                 p.Position += p.Velocity * dt;
                 p.Velocity *= 0.95f; // Ralentissement léger
                 p.Size += dt * 5f;   // Expansion légère

                 // Calculer l'alpha pour l'effet de dissipation
                 float lifeRatio = p.Lifespan / p.MaxLifespan;
                 byte alpha = (byte)(255 * (1f - lifeRatio));
                 p.Tint.A = alpha;

                 smokeParticles[i] = p; // Remettre la structure modifiée dans la liste
             }
         }
     }

     static void DrawSmokeParticles()
     {
         foreach (SmokeParticle p in smokeParticles)
         {
             // Dessiner un cercle simple pour la particule
             Raylib.DrawCircleV(p.Position, p.Size, p.Tint);
             // On pourrait utiliser DrawTexturePro avec une texture de fumée pour un meilleur effet
         }
     }


     // --- Autres Fonctions Utilitaires ---
     static void ResetGame(ref GameState state, ref Vector2 playerPos, ref List<Vector2> zombies, ref List<Vector2> bullets, ref List<Vector2> bulletDirections,
                           ref List<int> zombieHealths, ref int round, ref int zombiesSpawned, ref int zombiesToSpawn,
                           ref int playerHits, ref int ammo, int maxAmmo, ref bool canSprint, ref float sprintTimer, ref float sprintCooldownTimer)
     {
         playerPos = new Vector2(screenWidth / 2, screenHeight / 2);
         zombies.Clear();
         bullets.Clear();
         bulletDirections.Clear();
         zombieHealths.Clear();
         smokeParticles.Clear(); // Vider aussi les particules de fumée
         round = 1;
         zombiesSpawned = 0;
         zombiesToSpawn = 5 + round * 3; // Réinitialiser correctement
         playerHits = 0;
         ammo = maxAmmo;
         canSprint = true;
         sprintTimer = 0f;
         sprintCooldownTimer = 0f;
         // Ne pas changer 'state' ici, c'est fait dans l'appelant
     }

     static Color ColorAlpha(Color color, float alpha)
     {
         byte newAlpha = (byte)(Math.Clamp(alpha, 0f, 1f) * 255);
         return new Color(color.R, color.G, color.B, newAlpha);
     }
 }