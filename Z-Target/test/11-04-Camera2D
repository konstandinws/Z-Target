         Raylib.DrawText("GAME OVER", screenWidth / 2 - Raylib.MeasureText("GAME OVER", 40) / 2, screenHeight / 2 - 40, 40, Color.Red);
         Raylib.DrawText($"You survived {round - 1} rounds!", screenWidth / 2 - Raylib.MeasureText($"You survived {round - 1} rounds!", 20) / 2, screenHeight / 2 + 10, 20, Color.White);
         Raylib.DrawText("Press ENTER to return to Menu", screenWidth / 2 - Raylib.MeasureText("Press ENTER to return to Menu", 20) / 2, screenHeight / 2 + 50, 20, Color.LightGray);
