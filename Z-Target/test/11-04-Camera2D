using Raylib_cs;
 using System.Numerics;
 using System.Collections.Generic;
 using System;

 // Structure simple pour une particule de fumée (inchangée)
 struct SmokeParticle
 {
     public Vector2 Position;
     public Vector2 Velocity;
     public float Lifespan;
     public float MaxLifespan;
     public float Size;
     public Color Tint;
 }

 class Program
 {
     enum GameState { Menu, Playing, GameOver }

     // --- Constantes et Variables Globales ---
     const int screenWidth = 1200;
     const int screenHeight = 800;

     // *** NOUVEAU: Caméra 2D ***
     static Camera2D camera;

     // Variables Voiture Sprite Stack (inchangées)
     const int carSliceCount = 8;
     const float carScale = 6.0f;
     const float carRotationSpeed = 30f;
     static Vector2 carPosition = new Vector2(400, 400); // Position dans le monde
     static Texture2D[] carSlices = new Texture2D[carSliceCount];
     static float carCurrentAngle = 0f;
     static int carBaseSliceOffset = 3;

     // Variables Effet Fumée (inchangées)
     static List<SmokeParticle> smokeParticles = new List<SmokeParticle>();
     static Random random = new Random();

     // Variables de jeu (certaines initialisations peuvent être déplacées dans ResetGame)
     static GameState state = GameState.Menu;
     static Vector2 playerPos;
     static Vector2 playerSize = new Vector2(50, 50);
     static float PlayerSpeed = 400.0f;
     static float zombieBaseSpeed = 100.0f;
     static int zombieBaseHealth = 3;
     static int ammo = 12;
     static int maxAmmo = 12;
     static bool reloading = false;
     static float reloadTime = 2f;
     static float reloadTimer = 0f;
     static List<Vector2> bullets = new List<Vector2>();
     static List<Vector2> bulletDirections = new List<Vector2>();
     static float bulletSpeed = 1600.0f;
     static List<Vector2> zombies = new List<Vector2>();
     static List<int> zombieHealths = new List<int>();
     static float zombieSpawnTimer = 0f;
     static float zombieSpawnInterval = 0.5f;
     static int zombiesToSpawn = 5;
     static int zombiesSpawned = 0;
     static int round = 1;
     static float playerHitCooldown = 0.5f;
     static float playerHitTimer = 0f;
     static int playerHits = 0;
     static float redScreenAlpha = 0f;
     static float regenTimer = 0f;
     static float regenDelay = 3f;
     static float sprintTimer = 0f;
     static float sprintDuration = 3f;
     static float sprintCooldown = 5f;
     static float sprintCooldownTimer = 0f;
     static bool canSprint = true;


     static void Main()
     {
         Raylib.InitWindow(screenWidth, screenHeight, "Zombie Shooter with Camera");
         Raylib.SetTargetFPS(60);

         // --- Chargement Ressources ---
         LoadCarTextures();

         // --- Initialisation du Jeu ---
         InitializeGame(); // Met l'initialisation dans une fonction

         // --- Boucle Principale ---
         while (!Raylib.WindowShouldClose())
         {
             float dt = Raylib.GetFrameTime();
             Vector2 mouseScreenPos = Raylib.GetMousePosition(); // Position souris écran (pour UI éventuelle)
             Vector2 mouseWorldPos = Raylib.GetScreenToWorld2D(mouseScreenPos, camera); // Position souris monde

             // --- Mise à jour ---
             switch (state)
             {
                 case GameState.Menu:
                     if (Raylib.IsKeyPressed(KeyboardKey.Enter))
                     {
                         state = GameState.Playing;
                         // Assurer que le jeu est réinitialisé en passant au jeu
                         ResetGame();
                     }
                     break;

                 case GameState.Playing:
                     UpdatePlaying(dt, mouseWorldPos); // Passe la position souris monde

                     // Mettre à jour l'angle de la voiture
                     carCurrentAngle = (carCurrentAngle + carRotationSpeed * dt) % 360;

                     // Mettre à jour les particules de fumée
                     UpdateSmokeParticles(dt);

                     // Détection de collision Joueur vs Voiture
                     CheckPlayerCarCollision(playerPos, playerSize);

                     // *** METTRE A JOUR LA CAMERA POUR SUIVRE LE JOUEUR ***
                     camera.Target = playerPos;
                     // Optionnel: ajouter du LERP pour un suivi plus doux:
                     // camera.Target = Vector2.Lerp(camera.Target, playerPos, dt * 5.0f);

                     break;

                 case GameState.GameOver:
                     if (Raylib.IsKeyPressed(KeyboardKey.Enter))
                     {
                         state = GameState.Menu;
                         // Pas besoin de ResetGame ici car il sera appelé en entrant dans Playing
                     }
                     break;
             }

             // --- Dessin ---
             Raylib.BeginDrawing();
             Raylib.ClearBackground(Color.DarkGray); // Un fond plus sombre pour le jeu

             switch (state)
             {
                 case GameState.Menu:
                     DrawMenu();
                     break;

                 case GameState.Playing:
                     // *** COMMENCER LE MODE CAMERA ***
                     Raylib.BeginMode2D(camera);

                     // -- Dessiner les éléments du MONDE --
                     // (Optionnel) Dessiner un fond ou une grille pour voir le mouvement
                     DrawWorldBackground();

                     // Dessiner la voiture
                     DrawCar(carPosition, carCurrentAngle, carScale, carBaseSliceOffset, carSlices);

                     // Dessiner les zombies
                     DrawZombies(); // Fonction séparée pour clarté

                     // Dessiner les balles
                     DrawBullets(); // Fonction séparée

                     // Dessiner les particules de fumée
                     DrawSmokeParticles(); // Fonction inchangée

                     // Dessiner le joueur (après les autres éléments du monde si on veut qu'il soit au-dessus)
                     DrawPlayer(mouseWorldPos); // Passe la position souris monde pour l'angle

                     // *** FIN DU MODE CAMERA ***
                     Raylib.EndMode2D();

                     // -- Dessiner les éléments de l'INTERFACE (hors caméra) --
                     DrawUI(); // Fonction séparée

                     break;

                 case GameState.GameOver:
                     DrawGameOver();
                     break;
             }


             // Dessiner le curseur personnalisé (facultatif) après tout le reste
             Raylib.DrawCircleV(mouseScreenPos, 5, Color.Red); // Simple cercle rouge comme curseur

             Raylib.EndDrawing();
         }

         // --- Nettoyage ---
         UnloadCarTextures();
         Raylib.CloseWindow();
     }

     // --- Fonctions Initialisation & Reset ---
     static void InitializeGame()
     {
        // Initialisation Camera
        camera = new Camera2D();
        camera.Offset = new Vector2(screenWidth / 2f, screenHeight / 2f);
        camera.Rotation = 0f;
        camera.Zoom = 1.0f;

        // Mettre les réinitialisations ici aussi pour le premier démarrage
        ResetGame();
        state = GameState.Menu; // Commencer au menu
     }

     static void ResetGame()
     {
         playerPos = new Vector2(screenWidth / 2, screenHeight / 2); // Position initiale monde
         camera.Target = playerPos; // La caméra cible le joueur dès le début
         zombies.Clear();
         bullets.Clear();
         bulletDirections.Clear();
         zombieHealths.Clear();
         smokeParticles.Clear();
         round = 1;
         zombieBaseHealth = 3; // Remettre la vie de base
         zombiesSpawned = 0;
         zombiesToSpawn = 5 + round * 3;
         zombieSpawnInterval = 0.5f; // Remettre l'intervalle de base
         playerHits = 0;
         ammo = maxAmmo;
         reloading = false;
         reloadTimer = 0f;
         canSprint = true;
         sprintTimer = 0f;
         sprintCooldownTimer = 0f;
         redScreenAlpha = 0f;
         regenTimer = 0f;
     }

     // --- Fonctions de Mise à Jour (pour Playing) ---
     static void UpdatePlaying(float dt, Vector2 mouseWorldPos) // Prend mouseWorldPos
     {
         Vector2 direction = Vector2.Zero; // Variable locale maintenant
         float PlayerSpeedModifier = 1.0f; // Variable locale

         // --- Mouvement Joueur ---
         if (Raylib.IsKeyDown(KeyboardKey.W)) direction.Y -= 1;
         if (Raylib.IsKeyDown(KeyboardKey.S)) direction.Y += 1;
         if (Raylib.IsKeyDown(KeyboardKey.A)) direction.X -= 1;
         if (Raylib.IsKeyDown(KeyboardKey.D)) direction.X += 1;
         if (direction != Vector2.Zero) direction = Vector2.Normalize(direction);

         // --- Sprint (logique inchangée, utilise les variables globales/statiques) ---
         PlayerSpeedModifier = 1.0f;
         // ... (copier/coller la logique de sprint d'avant)
         if (Raylib.IsKeyDown(KeyboardKey.LeftShift) && canSprint && !reloading) {
             if (sprintTimer < sprintDuration) {
                 PlayerSpeedModifier = 1.5f;
                 sprintTimer += dt;
             } else {
                 canSprint = false;
                 sprintCooldownTimer = 0f;
             }
         } else {
             if (!canSprint) {
                 sprintCooldownTimer += dt;
                 if (sprintCooldownTimer >= sprintCooldown) {
                     canSprint = true;
                     sprintTimer = 0f;
                     sprintCooldownTimer = 0f;
                 }
             } else if (sprintTimer > 0f) {
                 sprintTimer -= dt / 2f;
                 if (sprintTimer < 0f) sprintTimer = 0f;
             }
         }


         playerPos += direction * PlayerSpeed * PlayerSpeedModifier * dt;
         // Laisser le joueur se déplacer librement, la caméra suivra
         // On pourrait ajouter des limites au monde si nécessaire


         // --- Tir --- Utilise mouseWorldPos
         if (Raylib.IsMouseButtonPressed(MouseButton.Left) && ammo > 0 && !reloading)
         {
             Vector2 shootDir = Vector2.Normalize(mouseWorldPos - playerPos);
             bullets.Add(playerPos); // La balle part du centre du joueur
             bulletDirections.Add(shootDir);
             ammo--;
         }

         // --- Rechargement (logique inchangée) ---
         if (Raylib.IsKeyPressed(KeyboardKey.R) && ammo < maxAmmo && !reloading)
         {
             reloading = true;
             reloadTimer = 0f;
         }
         if (reloading)
         {
             reloadTimer += dt;
             if (reloadTimer >= reloadTime)
             {
                 ammo = maxAmmo;
                 reloading = false;
             }
         }

         // --- Mise à jour Balles & Collisions Balles/Zombies ---
         // Calculer les limites de la vue caméra pour la disparition des balles
         Vector2 viewTopLeft = Raylib.GetScreenToWorld2D(Vector2.Zero, camera);
         Vector2 viewBottomRight = Raylib.GetScreenToWorld2D(new Vector2(screenWidth, screenHeight), camera);
         float despawnMargin = 100f; // Marge supplémentaire pour la disparition

         for (int i = bullets.Count - 1; i >= 0; i--)
         {
             bullets[i] += bulletDirections[i] * bulletSpeed * dt;
             bool removed = false;

             // Collision avec Zombies
             for (int j = zombies.Count - 1; j >= 0; j--)
             {
                 if (Vector2.Distance(zombies[j], bullets[i]) < 25 + 5)
                 {
                     zombieHealths[j]--;
                     bullets.RemoveAt(i);
                     bulletDirections.RemoveAt(i);
                     removed = true;
                     if (zombieHealths[j] <= 0)
                     {
                         zombies.RemoveAt(j);
                         zombieHealths.RemoveAt(j);
                         // Ajouter score, son, effet visuel?
                     }
                     break;
                 }
             }
             if (removed) continue;

             // Sortie de la vue caméra (+ marge)
             if (bullets[i].X < viewTopLeft.X - despawnMargin ||
                 bullets[i].X > viewBottomRight.X + despawnMargin ||
                 bullets[i].Y < viewTopLeft.Y - despawnMargin ||
                 bullets[i].Y > viewBottomRight.Y + despawnMargin)
             {
                 bullets.RemoveAt(i);
                 bulletDirections.RemoveAt(i);
             }
         }


         // --- Spawn Zombies --- Autour du joueur, hors de la vue immédiate
         zombieSpawnTimer += dt;
         if (zombiesSpawned < zombiesToSpawn && zombieSpawnTimer >= zombieSpawnInterval)
         {
             zombieSpawnTimer = 0f;
             // Distance de spawn basée sur la diagonale de l'écran + marge
             float spawnDistance = MathF.Sqrt(screenWidth * screenWidth + screenHeight * screenHeight) * 0.6f; // 60% de la diagonale
             float angle = (float)(random.NextDouble() * Math.PI * 2);
             Vector2 spawnPos = playerPos + new Vector2(MathF.Cos(angle), MathF.Sin(angle)) * spawnDistance;

             zombies.Add(spawnPos);
             zombieHealths.Add(zombieBaseHealth + (round / 3));
             zombiesSpawned++;
         }

         // --- Mise à jour Zombies & Collisions Zombies/Joueur (logique inchangée) ---
         playerHitTimer -= dt;
         bool playerGotHitThisFrame = false;

         for (int i = zombies.Count - 1; i >= 0; i--)
         {
             Vector2 zDir = Vector2.Normalize(playerPos - zombies[i]);
             float zSpeed = zombieBaseSpeed + (round * 10);
             zombies[i] += zDir * zSpeed * dt;

             if (Vector2.Distance(zombies[i], playerPos) < 25 + playerSize.X / 2 && playerHitTimer <= 0)
             {
                 playerHits++;
                 redScreenAlpha = 0.6f;
                 playerHitTimer = playerHitCooldown;
                 playerGotHitThisFrame = true;
                 if (playerHits >= 3)
                 {
                     state = GameState.GameOver;
                     return;
                 }
                 // Ajouter son de dégât, secousse écran?
             }
         }

         // --- Régénération Vie (logique inchangée) ---
         if (!playerGotHitThisFrame) {
             regenTimer += dt;
             if (regenTimer >= regenDelay && playerHits > 0)
             {
                 playerHits--;
                 regenTimer = 0f;
             }
         } else {
             regenTimer = 0f;
         }


         // --- Fin de Manche (logique inchangée) ---
         if (zombiesSpawned == zombiesToSpawn && zombies.Count == 0)
         {
             round++;
             zombiesToSpawn = 5 + round * 3;
             zombieBaseHealth++;
             zombieSpawnInterval = Math.Max(0.1f, 0.5f - round * 0.02f);
             zombiesSpawned = 0;
             ammo = maxAmmo;
             reloading = false;
             reloadTimer = 0f;
             // Son de fin de manche? Affichage "Round X" au milieu?
         }

         // --- Effet écran rouge (logique inchangée) ---
         if (redScreenAlpha > 0)
         {
             redScreenAlpha -= dt * 1.5f;
             if (redScreenAlpha < 0) redScreenAlpha = 0f;
         }
     }

     // --- Fonctions de Dessin ---

     static void DrawWorldBackground()
     {
         // Exemple: Dessiner une grille simple pour voir le mouvement de la caméra
         int gridSize = 100;
         Color gridColor = new Color(100, 100, 100, 100); // Gris semi-transparent

         Vector2 viewTopLeft = Raylib.GetScreenToWorld2D(Vector2.Zero, camera);
         Vector2 viewBottomRight = Raylib.GetScreenToWorld2D(new Vector2(screenWidth, screenHeight), camera);

         // Lignes verticales
         for (float x = MathF.Floor(viewTopLeft.X / gridSize) * gridSize; x < viewBottomRight.X; x += gridSize)
         {
             Raylib.DrawLineV(new Vector2(x, viewTopLeft.Y), new Vector2(x, viewBottomRight.Y), gridColor);
         }
         // Lignes horizontales
         for (float y = MathF.Floor(viewTopLeft.Y / gridSize) * gridSize; y < viewBottomRight.Y; y += gridSize)
         {
             Raylib.DrawLineV(new Vector2(viewTopLeft.X, y), new Vector2(viewBottomRight.X, y), gridColor);
         }
     }

     static void DrawPlayer(Vector2 mouseWorldPos)
     {
        float playerAngle = MathF.Atan2(mouseWorldPos.Y - playerPos.Y, mouseWorldPos.X - playerPos.X) * Raylib.RAD2DEG;
        Raylib.DrawRectanglePro(new Rectangle(playerPos.X, playerPos.Y, playerSize.X, playerSize.Y), new Vector2(playerSize.X / 2, playerSize.Y / 2), playerAngle, Color.Maroon);
     }

     static void DrawBullets()
     {
         foreach (Vector2 bullet in bullets)
         {
             Raylib.DrawCircleV(bullet, 5, Color.Yellow); // Balle plus visible
         }
     }

     static void DrawZombies()
     {
          // Utiliser un index pour accéder à zombieHealths si nécessaire pour la barre de vie
         for(int i = 0; i < zombies.Count; i++)
         {
             Vector2 zombiePos = zombies[i];
             Raylib.DrawCircleV(zombiePos, 25, Color.Lime); // Vert citron

             // Barre de vie (exemple - nécessite la bonne vie max)
             int currentHealth = zombieHealths[i];
             int maxHealthForZombie = zombieBaseHealth + (round / 3); // Recalculer la vie max pour ce zombie
             float healthRatio = (float)currentHealth / maxHealthForZombie;
             Vector2 healthBarPos = new Vector2(zombiePos.X - 15, zombiePos.Y - 35);
             Raylib.DrawRectangleV(healthBarPos, new Vector2(30, 5), Color.DarkGray);
             Raylib.DrawRectangleV(healthBarPos, new Vector2(30 * healthRatio, 5), Color.Red);
         }
     }


     static void DrawUI() // Dessine l'interface utilisateur sur l'écran (pas dans le monde)
     {
        Raylib.DrawText($"Round: {round}", 10, 10, 20, Color.White);
        Raylib.DrawText($"Zombies Left: {zombies.Count + (zombiesToSpawn - zombiesSpawned)}", 10, 35, 20, Color.White);
        Raylib.DrawText($"Ammo: {ammo}/{maxAmmo}", screenWidth - 150, screenHeight - 30, 20, Color.White);
        Raylib.DrawText($"Health Hits: {3 - playerHits}/3", screenWidth - 150, 10, 20, playerHits < 2 ? Color.SkyBlue : Color.Orange);

        // Indicateur de rechargement
        if (reloading)
        {
            Raylib.DrawCircleSector(new Vector2(screenWidth - 60, screenHeight - 60), 30, -90, -90 + 360 * (reloadTimer / reloadTime), 32, ColorAlpha(Color.LightGray, 0.7f));
            Raylib.DrawText("R", screenWidth - 65, screenHeight - 68, 20, Color.Black);
        } else if (ammo == 0) {
             Raylib.DrawText("RELOAD!", screenWidth / 2 - Raylib.MeasureText("RELOAD!", 30)/2, 50, 30, Color.Red);
        }

        // Barre de sprint
         Raylib.DrawRectangle(10, screenHeight - 30, 150, 20, Color.DarkGray);
         float sprintRatio = canSprint ? (sprintDuration - sprintTimer) / sprintDuration : 0;
         Raylib.DrawRectangle(10, screenHeight - 30, (int)(150 * sprintRatio), 20, Color.Orange);
         if (!canSprint) {
             float cooldownRatio = sprintCooldownTimer / sprintCooldown;
             Raylib.DrawRectangle(10, screenHeight - 30, (int)(150 * cooldownRatio), 20, ColorAlpha(Color.Red, 0.5f));
             Raylib.DrawText("Cooldown", 20, screenHeight - 28, 18, Color.White);
         } else {
            Raylib.DrawText("Sprint", 20, screenHeight - 28, 18, Color.Black);
         }


        // Effet écran rouge si touché (peut être dessiné sur l'UI)
        if (redScreenAlpha > 0)
        {
            Raylib.DrawRectangle(0, 0, screenWidth, screenHeight, ColorAlpha(Color.Red, redScreenAlpha));
        }
     }

