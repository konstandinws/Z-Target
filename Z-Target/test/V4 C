// Zombie Shooter Game
using Raylib_cs;
using System.Numerics;
using static Raylib_cs.Raylib;

class Program
{
    static void Main()
    {
        const int screenWidth = 1200;
        const int screenHeight = 800;
        InitWindow(screenWidth, screenHeight, "Zombie Shooter Game");
        SetTargetFPS(60);

        GameManager gameManager = new GameManager(screenWidth, screenHeight);
        gameManager.LoadContent();

        while (!WindowShouldClose())
        {
            float deltaTime = GetFrameTime();

            gameManager.Update(deltaTime);

            BeginDrawing();
            ClearBackground(Color.WHITE);
            gameManager.Draw();
            EndDrawing();
        }

        CloseWindow();
    }
}

class GameManager
{
    public enum GameState { Menu, Playing, GameOver }

    private int screenWidth;
    private int screenHeight;
    private GameState currentState = GameState.Menu;
    private Player player;
    private List<Zombie> zombies = new List<Zombie>();
    private List<Bullet> bullets = new List<Bullet>();
    private List<Vector2> spawnPoints = new List<Vector2>();
    private float spawnTimer = 0;
    private float spawnDelay = 0.5f;
    private int round = 1;
    private int zombiesPerRound = 5;
    private int zombiesSpawned = 0;
    private int zombiesKilled = 0;
    private float roundTransitionTimer = 0f;
    private bool isRoundTransition = false;

    private bool hasFastReload = false;
    private bool hasSelfRevive = false;

    private Machine fastReloadMachine;
    private Machine selfReviveMachine;

    public GameManager(int width, int height)
    {
        screenWidth = width;
        screenHeight = height;
    }

    public void LoadContent()
    {
        player = new Player(screenWidth / 2, screenHeight / 2);

        spawnPoints.Add(new Vector2(-100, 100));
        spawnPoints.Add(new Vector2(screenWidth + 100, 300));
        spawnPoints.Add(new Vector2(200, -100));
        spawnPoints.Add(new Vector2(600, screenHeight + 100));
        spawnPoints.Add(new Vector2(screenWidth + 100, screenHeight + 100));

        fastReloadMachine = new Machine(new Vector2(200, 700), "Fast Reload", () =>
        {
            hasFastReload = true;
            player.SetReloadSpeed(0.5f);
        });

        selfReviveMachine = new Machine(new Vector2(1000, 700), "Self Revive", () =>
        {
            hasSelfRevive = true;
        });
    }

    public void Update(float deltaTime)
    {
        switch (currentState)
        {
            case GameState.Menu:
                if (IsKeyPressed(KeyboardKey.KEY_ENTER)) currentState = GameState.Playing;
                if (IsKeyPressed(KeyboardKey.KEY_ESCAPE)) CloseWindow();
                break;

            case GameState.Playing:
                if (!player.IsDead)
                {
                    player.Update(deltaTime);
                    UpdateBullets(deltaTime);
                    UpdateZombies(deltaTime);
                    CheckZombieCollisions();

                    spawnTimer += deltaTime;
                    if (spawnTimer >= spawnDelay && zombiesSpawned < zombiesPerRound)
                    {
                        zombies.Add(new Zombie(spawnPoints[GetRandomValue(0, spawnPoints.Count - 1)], player.Position, round));
                        zombiesSpawned++;
                        spawnTimer = 0;
                    }

                    if (zombiesKilled >= zombiesPerRound)
                    {
                        isRoundTransition = true;
                        roundTransitionTimer += deltaTime;

                        if (roundTransitionTimer > 2f)
                        {
                            round++;
                            zombiesKilled = 0;
                            zombiesSpawned = 0;
                            zombiesPerRound += 5;
                            roundTransitionTimer = 0f;
                            isRoundTransition = false;
                        }
                    }

                    fastReloadMachine.Update(player);
                    selfReviveMachine.Update(player);
                }
                else
                {
                    if (hasSelfRevive)
                    {
                        player.SelfRevive();
                        hasSelfRevive = false;
                        zombies.ForEach(z => z.MoveAwayFrom(player.Position));
                    }
                    else if (IsKeyPressed(KeyboardKey.KEY_R))
                    {
                        currentState = GameState.GameOver;
                    }
                }
                break;
        }
    }

    private void UpdateBullets(float deltaTime)
    {
        for (int i = bullets.Count - 1; i >= 0; i--)
        {
            bullets[i].Update(deltaTime);
            if (!bullets[i].IsOnScreen(screenWidth, screenHeight)) bullets.RemoveAt(i);
        }
    }

    private void UpdateZombies(float deltaTime)
    {
        foreach (var zombie in zombies)
        {
            zombie.Update(deltaTime, player.Position);
        }
    }

    private void CheckZombieCollisions()
    {
        for (int i = zombies.Count - 1; i >= 0; i--)
        {
            for (int j = bullets.Count - 1; j >= 0; j--)
            {
                if (Vector2.Distance(zombies[i].Position, bullets[j].Position) < 30)
                {
                    if (zombies[i].TakeDamage(1))
                    {
                        zombies.RemoveAt(i);
                        zombiesKilled++;
                    }
                    bullets.RemoveAt(j);
                    break;
                }
            }

            if (Vector2.Distance(zombies[i].Position, player.Position) < 40)
            {
                zombies[i].TryAttack(player);
            }
        }
    }

    public void Draw()
    {
        switch (currentState)
        {
            case GameState.Menu:
                DrawText("ZOMBIE SHOOTER", screenWidth / 2 - 200, screenHeight / 2 - 100, 40, Color.DARKRED);
                DrawText("Appuyez sur ENTREE pour jouer", screenWidth / 2 - 180, screenHeight / 2, 20, Color.BLACK);
                DrawText("ECHAP pour quitter", screenWidth / 2 - 100, screenHeight / 2 + 40, 20, Color.GRAY);
                break;

            case GameState.Playing:
                player.Draw();
                foreach (var bullet in bullets) bullet.Draw();
                foreach (var zombie in zombies) zombie.Draw();

                fastReloadMachine.Draw();
                selfReviveMachine.Draw();

                DrawText($"Score: {zombiesKilled * 10}", 10, 10, 20, Color.BLACK);
                DrawText($"Round: {round}", 10, 40, 20, Color.DARKBLUE);
                DrawText($"Balles: {player.Bullets}/{player.Magazine}", screenWidth - 180, screenHeight - 40, 20, Color.BLACK);

                if (player.Bullets == 0 && !player.IsReloading)
                    DrawText("RECHARGER (R)", screenWidth / 2 - 70, screenHeight - 50, 20, Color.RED);

                if (player.IsReloading)
                    DrawCircleLines(screenWidth - 100, screenHeight - 100, 30, Color.GRAY);

                if (isRoundTransition && (int)(roundTransitionTimer * 4) % 2 == 0)
                    DrawText($"ROUND {round}", screenWidth / 2 - 60, 100, 40, Color.RED);

                if (player.DamageOverlayAlpha > 0)
                    DrawRectangle(0, 0, screenWidth, screenHeight, Fade(Color.RED, player.DamageOverlayAlpha));
                break;

            case GameState.GameOver:
                DrawText("VOUS ÊTES MORT", screenWidth / 2 - 120, screenHeight / 2 - 50, 40, Color.RED);
                DrawText("Appuyez sur R pour recommencer", screenWidth / 2 - 150, screenHeight / 2 + 20, 20, Color.GRAY);
                break;
        }
    }

    public void AddBullet(Vector2 position, Vector2 direction)
    {
        bullets.Add(new Bullet(position, direction));
    }
}

