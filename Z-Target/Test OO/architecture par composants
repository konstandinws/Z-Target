// Interfaces
public interface IFireMode
{
    bool CanFire(Weapon weapon);
    void OnFire(Weapon weapon);
    void Update(Weapon weapon, float dt);
}

public interface IBulletGenerator
{
    List<Bullet> Generate(Vector2 origin, Vector2 target, Weapon weapon);
}

public interface IReloadBehavior
{
    void StartReload(Weapon weapon);
    void Update(Weapon weapon, float dt);
    bool IsReloading(Weapon weapon);
}

// Weapon class
public class Weapon
{
    public int Ammo;
    public int MaxAmmo;
    public float Cooldown = 0;

    public IFireMode FireMode;
    public IBulletGenerator BulletGen;
    public IReloadBehavior ReloadBehavior;

    public Weapon(IFireMode fireMode, IBulletGenerator bulletGen, IReloadBehavior reload)
    {
        FireMode = fireMode;
        BulletGen = bulletGen;
        ReloadBehavior = reload;
    }

    public void Update(float dt)
    {
        FireMode.Update(this, dt);
        ReloadBehavior.Update(this, dt);
    }

    public List<Bullet> TryFire(Vector2 origin, Vector2 target)
    {
        if (ReloadBehavior.IsReloading(this)) return null;
        if (!FireMode.CanFire(this)) return null;
        if (Ammo <= 0)
        {
            ReloadBehavior.StartReload(this);
            return null;
        }

        Ammo--;
        FireMode.OnFire(this);
        return BulletGen.Generate(origin, target, this);
    }
}

// FireMode implementations
public class AutoFire : IFireMode
{
    private float fireRate;
    private float timer;

    public AutoFire(float rate)
    {
        fireRate = rate;
    }

    public bool CanFire(Weapon weapon) => timer <= 0;

    public void OnFire(Weapon weapon) => timer = fireRate;

    public void Update(Weapon weapon, float dt)
    {
        if (timer > 0) timer -= dt;
    }
}

// BulletGenerator implementations
public class SingleBullet : IBulletGenerator
{
    public List<Bullet> Generate(Vector2 origin, Vector2 target, Weapon weapon)
    {
        return new List<Bullet> { new Bullet(origin, target, 500, 2) };
    }
}

public class ShotgunSpread : IBulletGenerator
{
    private int count;
    private float spread;

    public ShotgunSpread(int count, float spread)
    {
        this.count = count;
        this.spread = spread;
    }

    public List<Bullet> Generate(Vector2 origin, Vector2 target, Weapon weapon)
    {
        List<Bullet> bullets = new();
        float angle = MathF.Atan2(target.Y - origin.Y, target.X - origin.X);
        for (int i = 0; i < count; i++)
        {
            float offset = ((i - count / 2f) / count) * spread;
            float angleOffset = angle + offset;
            Vector2 dir = new Vector2(MathF.Cos(angleOffset), MathF.Sin(angleOffset));
            bullets.Add(new Bullet(origin, origin + dir * 100, 400, 1));
        }
        return bullets;
    }
}

// ReloadBehavior implementations
public class StandardReload : IReloadBehavior
{
    private float reloadTime;
    private float timer = 0;
    private bool reloading = false;

    public StandardReload(float time)
    {
        reloadTime = time;
    }

    public void StartReload(Weapon weapon)
    {
        reloading = true;
        timer = reloadTime;
    }

    public void Update(Weapon weapon, float dt)
    {
        if (!reloading) return;

        timer -= dt;
        if (timer <= 0)
        {
            weapon.Ammo = weapon.MaxAmmo;
            reloading = false;
        }
    }

    public bool IsReloading(Weapon weapon) => reloading;
}

// Bullet class
public class Bullet
{
    public Vector2 Position;
    public Vector2 Direction;
    public float Speed;
    public int Damage;

    public Bullet(Vector2 origin, Vector2 target, float speed, int damage)
    {
        Position = origin;
        Direction = Vector2.Normalize(target - origin);
        Speed = speed;
        Damage = damage;
    }

    public void Update(float dt)
    {
        Position += Direction * Speed * dt;
    }

    public void Draw()
    {
        Raylib.DrawCircleV(Position, 5, Color.Red);
    }
}

// Weapon factory
public class WeaponFactory
{
    public static Weapon CreateAK()
    {
        return new Weapon(
            new AutoFire(0.1f),
            new SingleBullet(),
            new StandardReload(2f)
        )
        {
            MaxAmmo = 30,
            Ammo = 30
        };
    }

    public static Weapon CreateShotgun()
    {
        return new Weapon(
            new AutoFire(0.8f),
            new ShotgunSpread(5, 0.4f),
            new StandardReload(3f)
        )
        {
            MaxAmmo = 8,
            Ammo = 8
        };
    }
}
