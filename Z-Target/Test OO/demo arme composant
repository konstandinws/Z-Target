using Raylib_cs;
using System.Numerics;
using System.Collections.Generic;

Raylib.InitWindow(800, 600, "Weapon Shop Test");
Raylib.SetTargetFPS(60);

Player player = new();
List<WeaponSpot> wallWeapons = new() {
    new WeaponSpot(new Vector2(100, 100), WeaponFactory.CreateAK, 500),
    new WeaponSpot(new Vector2(100, 200), WeaponFactory.CreateShotgun, 600),
    new WeaponSpot(new Vector2(100, 300), WeaponFactory.CreateGalil, 700),
};

MysteryBox mysteryBox = new(new Vector2(600, 300));

while (!Raylib.WindowShouldClose())
{
    float dt = Raylib.GetFrameTime();

    // Update
    player.Update(dt);

    foreach (var spot in wallWeapons)
        if (spot.IsPlayerNear(player) && Raylib.IsKeyPressed(KeyboardKey.E))
            player.TryBuyWeapon(spot);

    if (Vector2.Distance(player.Position, mysteryBox.Position) < 50 && Raylib.IsKeyPressed(KeyboardKey.E))
        mysteryBox.StartRoll();

    mysteryBox.Update(dt);
    if (mysteryBox.IsReady && Vector2.Distance(player.Position, mysteryBox.Position) < 50 && Raylib.IsKeyPressed(KeyboardKey.F))
        player.ReplaceMainWeapon(mysteryBox.TakeWeapon());

    if (Raylib.IsKeyPressed(KeyboardKey.Q))
        player.SwapWeapons();

    // Draw
    Raylib.BeginDrawing();
    Raylib.ClearBackground(Color.RayWhite);

    player.Draw();
    foreach (var spot in wallWeapons)
        spot.Draw();

    mysteryBox.Draw();

    Raylib.DrawText($"Points: {player.Points}", 10, 10, 20, Color.Black);
    Raylib.DrawText($"Weapon: {player.MainWeapon?.Name}", 10, 40, 20, Color.DarkBlue);
    Raylib.DrawText($"Secondary: {player.SecondaryWeapon?.Name}", 10, 70, 20, Color.DarkGray);

    Raylib.EndDrawing();
}

Raylib.CloseWindow();

// ----------- CLASSES ----------------

public class Player
{
    public Vector2 Position = new Vector2(400, 300);
    public float Speed = 200f;
    public Weapon MainWeapon { get; private set; }
    public Weapon SecondaryWeapon { get; private set; }
    public int Points = 100000;

    public Player()
    {
        MainWeapon = WeaponFactory.CreateGlock();
    }

    public void Update(float dt)
    {
        Vector2 dir = Vector2.Zero;
        if (Raylib.IsKeyDown(KeyboardKey.W)) dir.Y -= 1;
        if (Raylib.IsKeyDown(KeyboardKey.S)) dir.Y += 1;
        if (Raylib.IsKeyDown(KeyboardKey.A)) dir.X -= 1;
        if (Raylib.IsKeyDown(KeyboardKey.D)) dir.X += 1;
        if (dir != Vector2.Zero) dir = Vector2.Normalize(dir);
        Position += dir * Speed * dt;
    }

    public void Draw()
    {
        Raylib.DrawCircleV(Position, 20, Color.Blue);
    }

    public void ReplaceMainWeapon(Weapon newWeapon)
    {
        SecondaryWeapon = MainWeapon;
        MainWeapon = newWeapon;
    }

    public void SwapWeapons()
    {
        (MainWeapon, SecondaryWeapon) = (SecondaryWeapon, MainWeapon);
    }

    public void TryBuyWeapon(WeaponSpot spot)
    {
        if (Points >= spot.Cost)
        {
            Points -= spot.Cost;
            ReplaceMainWeapon(spot.WeaponFactory());
        }
    }
}

public class Weapon
{
    public string Name { get; }
    public Color DisplayColor { get; }
    public IFireMode FireMode { get; }
    public IBulletStyle BulletStyle { get; }
    public IReloadSystem ReloadSystem { get; }

    public Weapon(string name, Color displayColor, IFireMode fireMode, IBulletStyle bulletStyle, IReloadSystem reloadSystem)
    {
        Name = name;
        DisplayColor = displayColor;
        FireMode = fireMode;
        BulletStyle = bulletStyle;
        ReloadSystem = reloadSystem;
    }

    public void Fire()
    {
        FireMode.Fire(this);
    }

    public void Reload()
    {
        ReloadSystem.Reload(this);
    }
}

public interface IFireMode
{
    void Fire(Weapon weapon);
}

public class SemiAuto : IFireMode
{
    public void Fire(Weapon weapon)
    {
        Raylib.DrawText($"PEW (semi-auto) with {weapon.Name}", 300, 500, 20, Color.Black);
    }
}

public class AutoFire : IFireMode
{
    public void Fire(Weapon weapon)
    {
        Raylib.DrawText($"BAM (auto-fire) with {weapon.Name}", 300, 500, 20, Color.Black);
    }
}

public interface IBulletStyle
{
    void FireBullet(Weapon weapon);
}

public class StandardBullet : IBulletStyle
{
    public void FireBullet(Weapon weapon)
    {
        Raylib.DrawText($"Firing standard bullets with {weapon.Name}", 300, 520, 20, Color.Black);
    }
}

public class ExplosiveBullet : IBulletStyle
{
    public void FireBullet(Weapon weapon)
    {
        Raylib.DrawText($"Firing explosive bullets with {weapon.Name}", 300, 520, 20, Color.Red);
    }
}

public interface IReloadSystem
{
    void Reload(Weapon weapon);
}

public class FastReload : IReloadSystem
{
    public void Reload(Weapon weapon)
    {
        Raylib.DrawText($"Fast reload with {weapon.Name}", 300, 540, 20, Color.Green);
    }
}

public class SlowReload : IReloadSystem
{
    public void Reload(Weapon weapon)
    {
        Raylib.DrawText($"Slow reload with {weapon.Name}", 300, 540, 20, Color.Red);
    }
}

public static class WeaponFactory
{
    public static Weapon CreateAK() => new Weapon(
        "AK-47", Color.Red,
        new AutoFire(), new StandardBullet(), new SlowReload());

    public static Weapon CreateShotgun() => new Weapon(
        "Shotgun", Color.Green,
        new SemiAuto(), new ExplosiveBullet(), new SlowReload());

    public static Weapon CreateGalil() => new Weapon(
        "Galil", Color.Purple,
        new AutoFire(), new StandardBullet(), new FastReload());

    public static Weapon CreateGlock() => new Weapon(
        "Glock 1911", Color.Orange,
        new SemiAuto(), new StandardBullet(), new FastReload());
}

public class WeaponSpot
{
    public Vector2 Position;
    public Func<Weapon> WeaponFactory;
    public int Cost;

    public WeaponSpot(Vector2 position, Func<Weapon> factory, int cost)
    {
        Position = position;
        WeaponFactory = factory;
        Cost = cost;
    }

    public void Draw()
    {
        var weapon = WeaponFactory();
        Raylib.DrawRectangleV(Position, new Vector2(40, 40), weapon.DisplayColor);
        Raylib.DrawText($"{weapon.Name} - {Cost}$", (int)Position.X + 50, (int)Position.Y + 10, 10, Color.Black);
    }

    public bool IsPlayerNear(Player player) => Vector2.Distance(player.Position, Position) < 40;
}

public class MysteryBox
{
    public Vector2 Position;
    private List<Func<Weapon>> options;
    private float timer = 0f;
    private float totalTime = 2.5f;
    private Weapon preview;
    private bool rolling = false;
    private Random rand = new();

    public MysteryBox(Vector2 position)
    {
        Position = position;
        options = new List<Func<Weapon>> {
            WeaponFactory.CreateAK,
            WeaponFactory.CreateShotgun,
            WeaponFactory.CreateGalil,
            WeaponFactory.CreateGlock
        };
    }

    public void StartRoll()
    {
        if (!rolling)
        {
            rolling = true;
            timer = totalTime;
        }
    }

    public void Update(float dt)
    {
        if (rolling)
        {
            timer -= dt;
            preview = options[rand.Next(options.Count)]();
            if (timer <= 0)
            {
                rolling = false;
            }
        }
    }

    public bool IsReady => !rolling && preview != null;

    public Weapon TakeWeapon()
    {
        var result = preview;
        preview = null;
        return result;
    }

    public void Draw()
    {
        Color color = preview?.DisplayColor ?? Color.LightGray;
        Raylib.DrawRectangleV(Position, new Vector2(50, 50), color);
        Raylib.DrawText("Mystery Box", (int)Position.X - 20, (int)Position.Y - 20, 10, Color.Black);
        if (rolling)
            Raylib.DrawText("Rolling...", (int)Position.X - 20, (int)Position.Y + 60, 10, Color.Red);
        else if (preview != null)
            Raylib.DrawText($"{preview.Name} (Press F)", (int)Position.X - 20, (int)Position.Y + 60, 10, Color.DarkGreen);
    }
}
